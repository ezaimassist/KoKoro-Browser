# Bare Browser + Native Gaming Mode ARM64 GN Overlay
# Append this file AFTER Bare Browser's generated version-args.gn (`tools/version.py gn arm64`)
# Target: out/Default/args.gn inside Bare Browser's Ubuntu 22.04 Docker container

# --- Architecture & Release Optimization ---
target_os = "android"
target_cpu = "arm64"
is_debug = false
is_official_build = true
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
use_thin_lto = true
thin_lto_enable_optimizations = true
# Optimize hot loops (Skia, ANGLE, V8, Blink WebGL2) for speed over minimal binary size
optimize_for_size = false

# --- Preserve Bare Browser De-Googled & Extension Architecture ---
enable_extensions = true
enable_reporting = false
enable_crash_reporter = false
use_official_google_api_keys = false
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
safe_browsing_mode = 0
enable_remoting = false

# --- GPU Acceleration: Vulkan, ANGLE, Skia ---
use_vulkan = true
angle_enable_vulkan = true
angle_enable_gl = true
skia_use_vulkan = true
enable_gpu_service_logging = false

# --- V8 & WebAssembly (Critical for LastHavens WotLK 3.3.5a Wasm + Streamed Assets) ---
v8_enable_webassembly = true
v8_enable_turbofan = true
v8_enable_maglev = true
v8_enable_lazy_source_positions = true
v8_use_external_startup_data = true
# Enable NEON / ARM64 SIMD optimizations for Wasm
arm_use_neon = true

# --- Media & Networking ---
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_quic = true
